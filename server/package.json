{
  "name": "@syncexc/server",
  "version": "1.0.0",
  "private": true,
  "description": "SyncExc API server, workers, and real-time gateway",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "echo 'No build step required for ESM Node server'",
    "test": "node --test --test-reporter=spec tests/unit/*.test.js",
    "test:watch": "node --test --watch tests/unit/*.test.js",
    "test:integration": "node --test --test-reporter=spec tests/integration/*.test.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js"
  },
  "dependencies": {
    "@syncexc/shared": "*",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "big-integer": "^1.6.52",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.13",
    "pg": "^8.11.5",
    "pino": "^8.21.0",
    "pino-http": "^9.0.0",
    "prom-client": "^15.1.1",
    "speakeasy": "^2.0.0",
    "stripe": "^23.0.0",
    "teleproto": "^1.230.1",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "pino-pretty": "^10.3.1",
    "supertest": "^6.3.4"
  }
}
