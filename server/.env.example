# =============================================================================
# SyncExc Server — Environment
# =============================================================================
# Copy root `.env.example` to `.env` for the full monorepo. This file exists so
# the server can be run independently during focused development.
# =============================================================================

NODE_ENV=development
SERVER_PORT=4000
SERVER_HOST=0.0.0.0
SERVER_BASE_URL=http://localhost:4000
SERVER_API_PREFIX=/api/v1
SERVER_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syncexc
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-in-production-min-64-chars
JWT_REFRESH_SECRET=change-me-in-production-min-64-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_SECRET=change-me-in-production-min-64-chars
SESSION_COOKIE_NAME=syncexc_session
SESSION_TTL=30d

ENCRYPTION_MASTER_KEY=change-me-32-bytes-base64

LOG_LEVEL=info
LOG_FORMAT=pretty

AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

FEATURE_MARKETPLACE_ENABLED=true
FEATURE_AUTOMATION_ENABLED=true
FEATURE_SIMULATION_ENABLED=true
FEATURE_REFERRAL_ENABLED=true
FEATURE_COMMUNITY_ENABLED=true
FEATURE_DEVELOPER_API_ENABLED=true