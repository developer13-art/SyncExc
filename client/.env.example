# ==========================================
# SyncExc Client Environment
# ==========================================

# API endpoint
VITE_API_URL=http://localhost:4000/api/v1

# WebSocket endpoint
VITE_WS_URL=ws://localhost:4001/ws

# Application
VITE_APP_NAME=SyncExc
VITE_APP_URL=http://localhost:5173

# Feature flags (override server defaults for UI)
VITE_FEATURE_DEVELOPER_PLATFORM=true
VITE_FEATURE_COMMUNITY=true
VITE_FEATURE_MARKETPLACE=true
VITE_FEATURE_SIMULATION=true
VITE_FEATURE_REFERRAL=true

# Analytics (optional)
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_KEY=

# Environment badge
VITE_ENVIRONMENT=development