# ==========================================
# SyncExc Monorepo Root Environment
# ==========================================
# This file documents all environment variables used across the monorepo.
# Each workspace (server, client, admin) has its own .env file with the
# specific variables it needs.

# ==========================================
# Application
# ==========================================
NODE_ENV=development
APP_NAME=SyncExc
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:4000
API_VERSION=v1

# ==========================================
# Database (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syncexc
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# ==========================================
# Authentication
# ==========================================
JWT_SECRET=change-this-to-a-secure-random-string-of-at-least-64-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=change-this-session-secret
SESSION_MAX_AGE_MS=2592000000
MFA_ISSUER=SyncExc
MFA_WINDOW=1

# ==========================================
# Encryption
# ==========================================
ENCRYPTION_KEY=change-this-to-32-byte-base64-encoded-key
HASH_PEPPER=change-this-to-a-random-pepper-string

# ==========================================
# Email (SMTP)
# ==========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@syncexc.com
SMTP_FROM_NAME=SyncExc

# ==========================================
# Email Inbound (IMAP)
# ==========================================
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# ==========================================
# Push Notifications
# ==========================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@syncexc.com

# ==========================================
# Payment Providers
# ==========================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# ==========================================
# Payout Providers
# ==========================================
STRIPE_CONNECT_CLIENT_ID=
PAYSTACK_TRANSFER_SECRET=

# ==========================================
# Exchange Integrations
# ==========================================
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443

BYBIT_API_BASE_URL=https://api.bybit.com
BYBIT_WS_BASE_URL=wss://stream.bybit.com

BITGET_API_BASE_URL=https://api.bitget.com
BITGET_WS_BASE_URL=wss://ws.bitget.com

OKX_API_BASE_URL=https://www.okx.com
OKX_WS_BASE_URL=wss://ws.okx.com:8443

# ==========================================
# Signal Source Integrations
# ==========================================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SESSION_ENCRYPTION_KEY=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

TRADINGVIEW_WEBHOOK_SECRET=

# ==========================================
# AI / LLM Providers
# ==========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-flash

AI_PROVIDER=openai
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_MS=30000

# ==========================================
# File Storage
# ==========================================
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ==========================================
# Redis (optional — used only where explicitly needed)
# ==========================================
REDIS_URL=
REDIS_ENABLED=false

# ==========================================
# Message Queue / Events
# ==========================================
QUEUE_DRIVER=database
SQS_QUEUE_URL=
SQS_REGION=
SNS_TOPIC_ARN=

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX=10

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ==========================================
# Feature Flags
# ==========================================
FEATURE_DEVELOPER_PLATFORM=true
FEATURE_COMMUNITY=true
FEATURE_MARKETPLACE=true
FEATURE_SIMULATION=true
FEATURE_REFERRAL=true

# ==========================================
# Observability
# ==========================================
LOG_LEVEL=info
LOG_FORMAT=pretty
METRICS_ENABLED=true
TRACING_ENABLED=false

# ==========================================
# WebSocket
# ==========================================
WS_PORT=4001
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL_MS=30000

# ==========================================
# Cron / Job Scheduler
# ==========================================
JOBS_ENABLED=true
JOBS_POLL_INTERVAL_MS=5000
JOBS_MAX_CONCURRENCY=10

# ==========================================
# Security
# ==========================================
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000